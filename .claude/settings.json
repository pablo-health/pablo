{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "cd \"$CLAUDE_PROJECT_DIR/backend\" && poetry run python \"$CLAUDE_PROJECT_DIR/.claude/skills/rls-coverage-check/check.py\" || true",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write",
        "conditions": [
          {
            "field": "tool_input.file_path",
            "operator": "contains",
            "value": "backend/app/db/models.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/backend/scripts/check_route_audit.py\" --hook",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(poetry run:*)",
      "Bash(poetry install)",
      "Bash(poetry lock:*)",
      "Bash(poetry add:*)",
      "Bash(poetry remove:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(bd)",
      "Bash(bd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)",
      "Bash(gcloud config list:*)",
      "Bash(gcloud config get-value:*)",
      "Bash(gcloud projects list:*)",
      "Bash(gcloud projects describe:*)",
      "Bash(gcloud run services list:*)",
      "Bash(gcloud run services describe:*)",
      "Bash(gcloud run revisions list:*)",
      "Bash(gcloud run revisions describe:*)",
      "Bash(gcloud sql instances list:*)",
      "Bash(gcloud sql instances describe:*)",
      "Bash(gcloud sql databases list:*)",
      "Bash(gcloud sql operations list:*)",
      "Bash(gcloud secrets list:*)",
      "Bash(gcloud secrets describe:*)",
      "Bash(gcloud secrets versions list:*)",
      "Bash(gcloud iam service-accounts list:*)",
      "Bash(gcloud iam service-accounts describe:*)",
      "Bash(gcloud logging read:*)",
      "Bash(gcloud logs read:*)",
      "Bash(gcloud builds list:*)",
      "Bash(gcloud builds describe:*)",
      "Bash(gcloud builds log:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(python .claude/skills/audit-coverage-check/check.py:*)",
      "Bash(python .claude/skills/migration-lint/check.py:*)",
      "Bash(python .claude/skills/phi-log-scan/check.py:*)",
      "Bash(python .claude/skills/rls-coverage-check/check.py)",
      "Bash(python .claude/skills/slop-sweep/check.py:*)",
      "Bash(python scripts/check_audit_params.py)",
      "Bash(bash scripts/check-version-sync.sh)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(git push --force origin main)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(gh repo delete:*)",
      "Bash(gcloud projects delete:*)",
      "Bash(gcloud sql instances delete:*)",
      "Bash(gcloud run services delete pablo:*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/service-account*.json)",
      "Read(./**/serviceaccount*.json)",
      "Read(./**/credentials.json)"
    ]
  }
}
