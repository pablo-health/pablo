# Frontend container environment for the end-to-end stack
# (docker-compose.e2e.yml). Nothing here is a secret: the auth project is
# an emulator-only "demo-" project, the API key is a placeholder the
# emulator accepts, and the cookie key signs cookies for a stack that lives
# on one machine for the length of a test run.
FIREBASE_PROJECT_ID=demo-pablo-e2e
# Without a service account the route-protection library asks the cloud
# metadata server for the project id; this answers it instead.
GOOGLE_CLOUD_PROJECT=demo-pablo-e2e
FIREBASE_API_KEY=e2e-emulator-placeholder-key
FIREBASE_AUTH_DOMAIN=localhost
FIREBASE_APP_ID=1:000000000000:web:e2e
# The server side of the frontend (session cookie, route protection) talks
# to the emulator over the stack's network.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9099
AUTH_COOKIE_SIGNATURE_KEY=e2e-cookie-signature-key-for-the-local-stack-only
# Matches the backend: the e2e user never enrolls a second factor.
REQUIRE_MFA=false
PUBLIC_BOOKING_ENABLED=true
# Which optional settings sections this deployment serves. The backend
# already runs the patient portal here (ENABLE_PATIENT_PORTAL on the API
# container), and the screens a practice builds its forms on are gated
# separately on this side — so without this the form builder's route is a
# 404 and no browser test can reach it.
FEATURES_ENABLED=patient_portal
PABLO_EDITION=core
