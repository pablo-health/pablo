# Byte-compiled / optimized
__pycache__/
*.py[cod]

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/

# Virtual environments
.venv/
venv/

# Distribution / packaging
*.egg-info/

# Environment
.env
.env.local
.env*.local
# Per-project blocking-function env (deploy-time config; keep the example)
functions/.env.*
!functions/.env.example

# OS
.DS_Store

# Node.js
node_modules/

# Next.js
.next/

# TypeScript incremental build cache
*.tsbuildinfo

# Firebase
firebase-debug.log
ui-debug.log

# NLI training data and model artifacts
backend/data/*.jsonl
backend/data/nli-therapy-*

# Claude Code: ship team-wide settings.json + skills, ignore per-developer overrides
.claude/settings.local.json
# Claude Code: worktree-isolated sub-agents materialize here at runtime;
# transient by design, never committed.
.claude/worktrees/
# Same thing at the repo root, which is where `git worktree add` lands by
# convention here. Unignored, a stray `git add -A` commits whole checkouts.
.worktrees/

# Operator-local scripts and notes (never committed; common convention
# for keeping environment-specific automation alongside the checkout).
local/

# Playwright MCP session artifacts (console logs, page snapshots) — local debug only
.playwright-mcp/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Per-run pentest reports detail the live attack surface — on-request only, never committed.
# (Methodology guide, README, and VULNERABILITY_EXCEPTIONS.md stay tracked.)
# The trailing wildcard also covers suffixed variants (e.g. *_pentest_report_OSS.md).
docs/pentest/*_pentest_report*.md

# Standalone Epic/MyChart puller output (FHIR JSON exports — may contain PHI)
epic_export/

# Local GCP/Firebase service-account keys and certs — never commit a real one,
# but keep any shipped .example template trackable.
serviceAccountKey.json
*firebase-adminsdk*.json
credentials.json
*.pem
*.p12
!*.example
