# Byte-compiled / optimized
__pycache__/
*.py[cod]

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/

# Virtual environments
.venv/
venv/

# Distribution / packaging
*.egg-info/

# Environment
.env
.env.local
.env*.local

# OS
.DS_Store

# Node.js
node_modules/

# Next.js
.next/

# TypeScript incremental build cache
*.tsbuildinfo

# Firebase
firebase-debug.log
ui-debug.log

# NLI training data and model artifacts
backend/data/*.jsonl
backend/data/nli-therapy-*

# Claude Code: ship team-wide settings.json + skills, ignore per-developer overrides
.claude/settings.local.json
# Claude Code: worktree-isolated sub-agents materialize here at runtime;
# transient by design, never committed.
.claude/worktrees/

# Operator-local scripts and notes (never committed; common convention
# for keeping environment-specific automation alongside the checkout).
local/

# Playwright MCP session artifacts (console logs, page snapshots) — local debug only
.playwright-mcp/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
