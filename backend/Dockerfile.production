# Backend Production Dockerfile
#
# Two-stage build on Chainguard Python images (Wolfi-based, daily patches,
# typically zero known CVEs). The security.yml workflow already scans
# these upstream bases — this Dockerfile is what makes that scan
# meaningful by actually using them.
#
# psycopg2-binary bundles libpq statically, so the runtime stage needs
# no OS packages — we use the distroless-style runtime variant.
#
# Base image digests below are bumped weekly by .github/workflows/base-image-bump.yml
# (Trivy-gated PR with auto-merge). Do not edit manually unless rolling back.
#
# Both bases can be overridden at build time, e.g. to build on the apko
# images described in images/python/README.md:
#   docker build -f backend/Dockerfile.production \
#     --build-arg BUILDER_IMAGE=<builder ref> --build-arg RUNTIME_IMAGE=<runtime ref> .
# The two must carry the same CPython minor version: the builder's
# installed packages are copied into the runtime's site-packages.
#
# trivy:ignore:DS-0026 — Cloud Run uses HTTP startup/liveness probes, not Docker HEALTHCHECK

# An ARG used by a FROM has to be declared before the first stage.
ARG BUILDER_IMAGE=cgr.dev/chainguard/python:latest-dev@sha256:87729167739190d9309588120a8ac0ffbf2eb95dd895abb9bada6bb9ecbf5a04
ARG RUNTIME_IMAGE=cgr.dev/chainguard/python:latest@sha256:be59f7abb600892c78e6ff0fe1a8f39549da13302dc003c8a5eb1c14b03d995c

# ---------- Stage 1: Builder ----------
FROM ${BUILDER_IMAGE} AS builder

WORKDIR /build

# The builder needs root to install into the system Python. This stage is
# discarded — only its site-packages are copied into the nonroot runtime
# stage below — so DL3002 ("last USER should not be root") doesn't apply.
# hadolint ignore=DL3002
USER root

# pip-install Poetry into the system python (no virtualenv); Chainguard
# :latest-dev already ships Python + pip. Upgrade pip first: the bundled
# line predates 26.1, which fixed the archive-interpretation and
# deferred-import-during-self-check issues. The upgraded pip lands in the
# site-packages copied into the runtime stage below. Poetry is pinned so
# the build is reproducible (DL3013).
RUN pip install --no-cache-dir --upgrade "pip>=26.1.1" \
    && pip install --no-cache-dir "poetry==2.4.1"

COPY pyproject.toml poetry.lock ./

RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root --only main

# Stage what the runtime needs under /staging, at the same absolute paths
# it has here, so the runtime stage copies it with one version-free COPY.
# The site-packages path comes from the interpreter rather than being
# written down, so a base on another CPython minor (python3.15, ...) needs
# no edit here. The path list is assigned before the loop on purpose:
# set -e cannot see a failing command substitution inside a for list, so
# a missing interpreter there would run the loop zero times and ship a
# runtime with no packages. As an assignment, the failure stops the build.
RUN set -eu; \
    dirs=$(python -c 'import sysconfig; print(" ".join(sorted({sysconfig.get_path("purelib"), sysconfig.get_path("platlib")})))'); \
    test -n "$dirs"; \
    for dir in $dirs; do \
        mkdir -p "/staging${dir}"; \
        cp -a "${dir}/." "/staging${dir}/"; \
    done; \
    mkdir -p /staging/usr/bin; \
    cp -a /usr/bin/uvicorn /staging/usr/bin/uvicorn


# ---------- Stage 2: Runtime ----------
FROM ${RUNTIME_IMAGE}

WORKDIR /app

# Installed Python packages and console scripts from the builder, merged
# into the runtime's own site-packages (staged above). The runtime image
# already ships a nonroot user (uid 65532), so no useradd is needed.
COPY --from=builder /staging/ /

# Fail the build, not the first start, if the copy is empty or landed in
# another CPython minor's site-packages (the two base images disagree).
# Exec form, because the runtime image has no shell.
RUN ["python", "-c", "import fastapi, uvicorn"]

# Application code
COPY --chown=nonroot:nonroot backend/ ./backend/
COPY --chown=nonroot:nonroot min_client_versions.json ./
COPY --chown=nonroot:nonroot backend/entrypoint.py ./entrypoint.py

EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

# Chainguard :latest already runs as nonroot (uid 65532) by default, but
# declare it explicitly so static scanners (Trivy DS-0002) don't flag it.
USER nonroot

# Chainguard runtime has ENTRYPOINT=["python"], so CMD is just args.
# Single worker required: the in-memory auth code store (native app
# code exchange) is process-local and cannot be shared across workers.
# Move to Redis-backed store before scaling to multiple workers.
CMD ["entrypoint.py"]
