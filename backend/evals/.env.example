# Braintrust eval harness — local config
# Copy this file to backend/evals/.env (gitignored) and fill in real values.

# Required: API key with write scope on the target Braintrust workspace.
# Treat this like a password. Rotate if it leaks into chat, logs, or screenshots.
BRAINTRUST_API_KEY=sk-your-key-here

# Required: project name. Braintrust auto-creates the project on first push.
# Future phases will use separate projects per surface (e.g. pablo-chat,
# pablo-note-generation). The scaffolding smoke test uses pablo-smoke.
BRAINTRUST_PROJECT=pablo-smoke

# Optional: default model for the smoke test. Must be a full Vertex
# publisher path for Gemini models (not the short name).
BRAINTRUST_DEFAULT_MODEL=publishers/google/models/gemini-2.5-flash
