# One hostname for the whole app. Caddy gets and renews its certificate from
# Let's Encrypt on its own (ports 80 and 443 must be open to the internet).
# The routes are in routes.caddy, shared with the local setup.

{
	email {$ACME_EMAIL}
}

{$PABLO_HOST} {
	# An update's progress, written by pablo-update-request, served from the
	# host so the browser can follow it while the backend restarts. Versions
	# and fixed messages only.
	handle /update-status.json {
		root * /srv/update
		rewrite * /status.json
		header Cache-Control no-store
		file_server
	}

	import routes.caddy
}
