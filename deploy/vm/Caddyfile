# One hostname for the whole app. Caddy gets and renews its certificate from
# Let's Encrypt on its own (ports 80 and 443 must be open to the internet).
# The frontend owns its auth and config routes under /api; every other /api
# path is the backend.

{
	email {$ACME_EMAIL}
}

{$PABLO_HOST} {
	encode zstd gzip

	request_body {
		max_size 64MB
	}

	@frontend_api path /api/config /api/login /api/logout /api/auth/*
	handle @frontend_api {
		reverse_proxy frontend:3000
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			# Streamed responses (note generation) go out as they are written.
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
