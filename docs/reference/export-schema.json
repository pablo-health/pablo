{
  "$defs": {
    "ClaimEvent": {
      "description": "One step in a claim's life, in the order it happened.",
      "properties": {
        "from_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From State"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "submitted, ch_accepted, payer_accepted, rejected, and so on.",
          "title": "Kind",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "to_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To State"
        }
      },
      "required": [
        "id",
        "kind",
        "from_state",
        "to_state",
        "occurred_at"
      ],
      "title": "ClaimEvent",
      "type": "object"
    },
    "ClaimLineAdjustment": {
      "description": "One adjustment the payer applied to a line, as its remittance said.",
      "properties": {
        "amount_cents": {
          "title": "Amount Cents",
          "type": "integer"
        },
        "group_code": {
          "title": "Group Code",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "group_code",
        "reason_code",
        "amount_cents"
      ],
      "title": "ClaimLineAdjustment",
      "type": "object"
    },
    "Communication": {
      "description": "One secure message.",
      "properties": {
        "attachment_document_ids": {
          "description": "Files sent with the message, by their id in documents[].",
          "items": {
            "type": "string"
          },
          "title": "Attachment Document Ids",
          "type": "array"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sender": {
          "enum": [
            "patient",
            "clinician",
            "practice"
          ],
          "title": "Sender",
          "type": "string"
        },
        "sent_at": {
          "format": "date-time",
          "title": "Sent At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sender",
        "sent_at",
        "body",
        "attachment_document_ids"
      ],
      "title": "Communication",
      "type": "object"
    },
    "Condition": {
      "description": "One diagnostic assessment and the diagnosis it recorded.",
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "icd10_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The ICD-10-CM code the clinician confirmed.",
          "title": "Icd10 Code"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "instrument": {
          "description": "The diagnostic definition the assessment followed.",
          "title": "Instrument",
          "type": "string"
        },
        "meets_criteria": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the recorded responses meet the definition's criteria; null for a checklist, which makes no determination.",
          "title": "Meets Criteria"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Id"
        },
        "status": {
          "description": "confirmed once the clinician has chosen a code.",
          "enum": [
            "confirmed",
            "unconfirmed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "icd10_code",
        "description",
        "assessed_at",
        "status",
        "instrument",
        "meets_criteria",
        "session_id"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Coverage": {
      "description": "One insurance plan on the client's chart, current or replaced.",
      "properties": {
        "active": {
          "description": "The plan the practice bills today.",
          "title": "Active",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "group_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "member_id": {
          "title": "Member Id",
          "type": "string"
        },
        "payer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The payer's electronic id, as printed on the card.",
          "title": "Payer Id"
        },
        "payer_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The payer as the practice lists it.",
          "title": "Payer Name"
        },
        "plan_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan Name"
        },
        "subscriber": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageSubscriber"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who holds the plan when the client does not."
        },
        "subscriber_relationship": {
          "description": "self, spouse, child or other.",
          "title": "Subscriber Relationship",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When eligibility was last checked.",
          "title": "Verified At"
        }
      },
      "required": [
        "id",
        "payer_name",
        "payer_id",
        "member_id",
        "group_number",
        "plan_name",
        "subscriber_relationship",
        "subscriber",
        "active",
        "verified_at",
        "created_at",
        "updated_at"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CoverageSubscriber": {
      "description": "The plan holder, when it is not the client.",
      "properties": {
        "date_of_birth": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Of Birth"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Name"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Name"
        },
        "sex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sex"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "date_of_birth",
        "sex"
      ],
      "title": "CoverageSubscriber",
      "type": "object"
    },
    "DocumentReference": {
      "description": "One note. ``final_content`` is what the clinician signed off on.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content"
        },
        "content_edited": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Edited"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "final_content": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Final Content"
        },
        "finalized_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finalized At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "note_type": {
          "title": "Note Type",
          "type": "string"
        },
        "restricted": {
          "description": "A psychotherapy note, readable by its author alone.",
          "title": "Restricted",
          "type": "boolean"
        },
        "was_edited": {
          "title": "Was Edited",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "note_type",
        "restricted",
        "content",
        "content_edited",
        "final_content",
        "was_edited",
        "created_at",
        "finalized_at"
      ],
      "title": "DocumentReference",
      "type": "object"
    },
    "Encounter": {
      "description": "One session, with its note when it has one.\n\n``transcript`` is absent, not null, when transcripts were not included,\nso an omitted transcript never reads as an empty one; the document's\n``options`` say which it was.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "document_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "session_date": {
          "format": "date-time",
          "title": "Session Date",
          "type": "string"
        },
        "session_number": {
          "title": "Session Number",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExportTranscript"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "session_number",
        "session_date",
        "status",
        "created_at",
        "document_reference"
      ],
      "title": "Encounter",
      "type": "object"
    },
    "ExportAppointment": {
      "description": "One appointment on the schedule, whatever became of it.",
