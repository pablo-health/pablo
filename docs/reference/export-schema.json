    "ExportCharge": {
      "description": "One row of the client's ledger: a charge, a payment, an adjustment.\n\nHow a card payment was taken is a category, never the card: no brand,\nno last four digits and no processor identifier are in any export.",
      "properties": {
        "amount_cents": {
          "description": "Always positive; kind says which way it goes.",
          "title": "Amount Cents",
          "type": "integer"
        },
        "appointment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The visit the row is for, in appointments[].",
          "title": "Appointment Id"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The claim the row was posted from, in claims[].",
          "title": "Claim Id"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the practice wrote about the row.",
          "title": "Description"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "session, copay, payment, patient_resp, contractual_adjustment, write_off or credit.",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "enum": [
                "card",
                "cash",
                "check",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "How a payment arrived, on rows that collect.",
          "title": "Method"
        },
        "payment_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A check number or similar.",
          "title": "Payment Reference"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "settled_by_charge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The payment that settled this row, in charges[].",
          "title": "Settled By Charge Id"
        },
        "status": {
          "description": "pending, succeeded, failed, refunded, disputed or dispute_lost.",
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updated At"
        },
        "write_off_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Write Off Reason"
        }
      },
      "required": [
        "id",
        "kind",
        "appointment_id",
        "claim_id",
        "description",
        "amount_cents",
        "currency",
        "status",
        "method",
        "payment_reference",
        "write_off_reason",
        "settled_by_charge_id",
        "recorded_at",
        "updated_at"
      ],
      "title": "ExportCharge",
      "type": "object"
    },
