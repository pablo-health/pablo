    "ExportDocument": {
      "description": "One uploaded file, carried in the archive as its original bytes.\n\n``bytes`` and ``sha256`` describe the file at ``archive_path`` exactly,\nso a consumer can check its copy against this entry alone.",
      "properties": {
        "archive_path": {
          "description": "Where the file is in this archive.",
          "title": "Archive Path",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
