        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "note_type": {
          "description": "The note type a session started from it is written in.",
          "title": "Note Type",
          "type": "string"
        },
        "place_of_service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "CMS place-of-service code, when recorded.",
          "title": "Place Of Service"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
