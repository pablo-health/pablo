# Development Mode Configuration
# Set to "true" to enable auto-authentication bypass (local dev only)
DEV_MODE=true

# Set to "mock" to use mock data, "api" to use real backend API
DATA_MODE=mock

# Local Development Authentication
# Enable local username/password authentication (dev mode only)
# WARNING: Only works when DEV_MODE=true
ENABLE_LOCAL_AUTH=false

# Backend API URL (used when DATA_MODE=api)
API_URL=http://localhost:8000

# Firebase Client Config (NEXT_PUBLIC_ = embedded in client bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Server Config (for next-firebase-auth-edge token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cookie signing key (generate with: openssl rand -base64 32)
AUTH_COOKIE_SIGNATURE_KEY=

# Additional public (unauthenticated) routes, comma-separated.
# The auth middleware protects everything except a built-in allowlist
# (/login, /mfa-enrollment, ...). A deployment that serves its own routes can
# name the ones that must be reachable without a session here — e.g. a page
# whose one-time token in the URL is itself the credential. Prefix-matched,
# so keep entries as specific as the route allows. Leave unset for the
# built-in allowlist alone.
EXTRA_PUBLIC_PATHS=

# Quality Rating Feedback Threshold
# Require written feedback when rating is below this value (1-5)
RATING_FEEDBACK_REQUIRED_BELOW=5

# Companion deep-link association files (served from /.well-known/*).
# Leave unset to return 404 (the association is simply undefined for the
# deploy). Set them to your own signed companion build's identifiers to let
# the OS route https://<your-domain>/launch/* to your desktop app.
#
# Apple App Site Association (macOS Universal Link):
AASA_TEAM_ID=
AASA_BUNDLE_ID=
# Windows App URI Handler (MSIX package family name):
WINDOWS_APP_PFN=
