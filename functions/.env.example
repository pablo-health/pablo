# Per-project env for the Identity Platform blocking functions.
#
# Copy to .env.<your-project-id> before `firebase deploy --only functions`;
# the Firebase CLI loads the file matching the --project flag. Real
# .env.<project> files stay untracked.
#
# Must be the SAME value as the backend's BACKEND_BASE_URL — it doubles as
# the OIDC audience on both ends of the blocking-function -> backend call
# (functions/src/index.ts mints the token for it; the backend's
# /api/ext/auth verifier checks it).
PABLO_BACKEND_URL=https://your-backend-url.example.com
