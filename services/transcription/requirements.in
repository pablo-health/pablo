# Direct dependencies of the transcription worker, as minimum versions.
# The image installs requirements.txt, the hashed lock compiled from this
# file. After editing a floor here, or to pick up newer releases, regenerate
# the lock from this directory and commit both files:
#
#   uv pip compile requirements.in --generate-hashes --python-version 3.12 \
#     --python-platform x86_64-manylinux_2_28 -o requirements.txt
#
# The target matches the image (Ubuntu 24.04, Python 3.12, x86_64). Then
# check the lock: pip-audit --no-deps --disable-pip -r requirements.txt
faster-whisper>=1.1.0
